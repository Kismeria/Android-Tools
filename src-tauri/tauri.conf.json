{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Android Tools",
  "mainBinaryName": "Android Tools",
  "version": "2.3.0",
  "identifier": "com.androidtools.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Android Tools",
        "width": 1200,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Kismeria",
    "copyright": "Copyright (c) 2026 Kismeria. MIT License.",
    "shortDescription": "Android Tools",
    "longDescription": "Control an Android phone from your PC: screen, apps, files, webcam.",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
